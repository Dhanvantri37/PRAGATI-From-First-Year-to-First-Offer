# ══════════════════════════════════════════════════════════════════════
# PRAGATI — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════

# ── MongoDB ───────────────────────────────────────────────────────────
MONGO_USER=pragati
MONGO_PASS=pragati_secret_change_me

# ── MySQL (JDBC for Java resume-parser) ──────────────────────────────
MYSQL_ROOT_PASSWORD=root_secret_change_me
MYSQL_USER=pragati_java
MYSQL_PASS=pragati_java_secret

# ── JWT Secrets ───────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_64char_hex
JWT_REFRESH_SECRET=change_me_different_64char_hex

# ── Cloudinary (file/resume storage) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ══════════════════════════════════════════════════════════════════════
# AI PROVIDER KEYS (for Interview Prep + AI Chat)
# PRAGATI uses Groq as primary (fast + free) and Gemini as fallback.
# At least one key is strongly recommended. Mock data works without keys.
# ══════════════════════════════════════════════════════════════════════

# ── Groq (PRIMARY — Recommended) ─────────────────────────────────────
# Free tier: 14,400 requests/day, ~300 tokens/sec (very fast)
# Get free key at: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Google Gemini (FALLBACK) ──────────────────────────────────────────
# Free tier: 15 req/min, 1M tokens/day
# Get free key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIza_your_gemini_key_here

# ── ElevenLabs (PREMIUM VOICES) ────────────────────────────────────────
# Get API key at: https://elevenlabs.io → Profile Settings
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
